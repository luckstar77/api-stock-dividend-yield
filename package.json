{
  "name": "api-stock-dividend-yield",
  "version": "1.0.0",
  "description": "提供股票的API查詢資料，例如:填權息成功率、除權息次數、填權息次數、統計年分、歷年平均現金殖利率、歷年平均還原殖利率。資料來自證交所與櫃買中心的開放資料",
  "main": "index.js",
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc",
    "sync": "node build/sync.js",
    "test": "tsc && node --test $(find build -name '*.test.js')",
    "lint": "eslint src --ext .ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckstar77/api-stock-dividend-yield.git"
  },
  "keywords": [
    "TAIWAN",
    "STOCK",
    "DIVIDEND",
    "YIELD"
  ],
  "author": "Allen Lai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/luckstar77/api-stock-dividend-yield/issues"
  },
  "homepage": "https://github.com/luckstar77/api-stock-dividend-yield#readme",
  "dependencies": {
    "axios": "^1.1.3",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "mongodb": "^4.10.0",
    "redis": "^4.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "eslint": "^8.24.0",
    "typescript": "^5.9.2"
  }
}
